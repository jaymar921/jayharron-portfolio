# ---------------------------------------------------------------------------
# Portfolio site, environment template
#
# Copy this file to .env and fill it in. .env is git ignored; this file is not,
# so never put a real secret in here.
#
#   cp _env .env
#
# On Vercel these same keys go in Project Settings, Environment Variables.
# ---------------------------------------------------------------------------


# --- Contact form (browser) --------------------------------------------------
VITE_APP_EMAILJS_SERVICE_ID=serviceId
VITE_APP_EMAILJS_TEMPLATE_ID=templateId
VITE_APP_EMAILJS_PUBLIC_KEY=publicKey

# Set to "false" to switch view and click tracking off in the browser.
VITE_ANALYTICS_ENABLED=true

# Where the browser sends its events. Leave empty when the site and the API are
# on the same origin, which is the case on Vercel and, via the dev proxy in
# vite.config.js, in local development too. The admin dashboard only works on
# the same origin, because its session cookie is SameSite=Strict by design.
VITE_API_BASE_URL=


# --- Database (server) -------------------------------------------------------
# The MongoDB connection string. Atlas gives you this under Connect, Drivers.
# Remember to URL encode the password if it contains @ : / or ?
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Which database inside the cluster the collections live in.
MONGODB_DB=jayharron_portfolio

# How many days a raw event row is kept before Mongo expires it. The rolled up
# counters are never expired, so the totals survive this. 0 keeps everything.
ANALYTICS_EVENT_TTL_DAYS=180


# --- Privacy -----------------------------------------------------------------
# Salt for the one way hash of a visitor's IP address. The raw address is never
# stored; the hash is only used for rate limiting.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_HASH_SALT=replace-me-with-a-long-random-string


# --- API server --------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma separated list of origins allowed to call the API from a browser.
# Leave this empty in development and any origin is allowed, which covers
# localhost and Vercel preview URLs at the same time. Set it in production.
# CORS_ALLOWED_ORIGINS=https://jayharronabejar.info
CORS_ALLOWED_ORIGINS=

# Request ceilings. Per hashed address unless the name says GLOBAL, which is
# across every address at once and caps the database work a flood spread over
# many addresses can cause. None of this replaces the host's own protection:
# on Vercel, turn on the Firewall and Attack Challenge Mode for a real flood.
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_TRACK_PER_MINUTE=120
RATE_LIMIT_TRACK_GLOBAL_PER_MINUTE=3000
RATE_LIMIT_ADMIN_PER_MINUTE=60
RATE_LIMIT_ADMIN_GLOBAL_PER_MINUTE=300
RATE_LIMIT_STATS_PER_MINUTE=30


# --- Admin dashboard ---------------------------------------------------------
# The gateway at /admin, where the analytics are read. There is no sign up
# form: an account is created from a terminal that already has these database
# credentials, with
#
#   npm run admin -- create [username]
#
# which prints a temporary password once. It has to be changed at first sign in.
#
# None of the settings below have to be set. The defaults are the strict ones.

# Minutes of inactivity before a session stops being accepted.
ADMIN_SESSION_IDLE_MINUTES=30

# Hard ceiling on a session, however active it is.
ADMIN_SESSION_MAX_HOURS=12

# How long a freshly issued temporary password stays usable.
ADMIN_TEMP_PASSWORD_HOURS=24

# Wrong passwords before the account stands down, and for how long.
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15

# Login attempts per address per quarter hour, before the per account lock.
RATE_LIMIT_ADMIN_LOGIN_PER_15_MIN=10

# Whether the session cookie is marked Secure. "auto" follows the protocol the
# request arrived on: https in production, plain http on the dev server, where
# a Secure cookie would be silently dropped. Force with "true" or "false".
ADMIN_COOKIE_SECURE=auto

# The cookie's name. Only worth changing if it collides with something else.
ADMIN_COOKIE_NAME=jha_admin
